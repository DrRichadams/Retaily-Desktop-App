{
  "name": "retaily",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,DESKTOP \"npm run dev:server\" \"wait-on tcp:4317 && npm run dev:desktop\"",
    "dev:desktop": "npm run dev --workspace=@retaily/desktop",
    "dev:server": "npm run dev --workspace=@retaily/server",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "wait-on": "^8.0.0"
  }
}
